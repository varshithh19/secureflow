# SecureFlow Environment Configuration
# Copy this file to .env and configure strong secrets in production

# Application Mode & Environment
APP_ENV=production
DEBUG=false
DEMO_MODE=true
HOST=0.0.0.0
PORT=8000

# Security & Cryptography Keys
# Generate random 256-bit keys for production (e.g. openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_for_production
JWT_SECRET_KEY=replace_with_a_secure_jwt_signing_key_for_production
CONTROLLER_SIGNING_KEY=replace_with_a_secure_controller_hmac_key_for_production

# Token Lifetimes (seconds)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8

# Database Connection
# SQLite default for local development/testing: sqlite+aiosqlite:///./secureflow.db
# PostgreSQL for production: postgresql+asyncpg://secureflow_user:secureflow_password@postgres:5432/secureflow_db
DATABASE_URL=sqlite:///./secureflow.db

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_TELEMETRY=120/minute
RATE_LIMIT_AUTH=10/minute

# Controller Simulator Endpoint
CONTROLLER_API_URL=http://localhost:8010/api/controller/apply
